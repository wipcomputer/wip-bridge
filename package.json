{
  "name": "wip-bridge",
  "version": "0.3.2",
  "description": "Platform bridge. Allows Claude Code CLI to talk to OpenClaw TUI agents and search shared agent memory",
  "type": "module",
  "main": "dist/index.js",
  "openclaw": {
    "extensions": [
      "./dist/openclaw.js"
    ]
  },
  "bin": {
    "lesa": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/core.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts src/core.ts --format esm --dts --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^11.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3"
  }
}
